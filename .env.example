# Copie este arquivo para .env e preencha os valores:
#   cp .env.example .env
# Nunca commite o .env: ele contém o token do bot.

# Token do bot: Developer Portal > sua aplicação > Bot > Reset Token
DISCORD_TOKEN=

# ID do servidor: botão direito no ícone do servidor > Copiar ID do servidor
GUILD_ID=

# ID do canal de voz: botão direito no canal de voz > Copiar ID do canal
VOICE_CHANNEL_ID=

# Pasta com os áudios (.mp3 ou .wav). Ignorado no Docker, que usa /app/Audios
AUDIO_FOLDER_PATH=Audios

# Opcional: intervalo entre gritos, em minutos (padrão 40 a 60)
MIN_MINUTES=40
MAX_MINUTES=60
